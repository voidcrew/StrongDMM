#include <winver.h>
1 ICON "internal/rsc/icon.ico"
1 VERSIONINFO
FILEVERSION @VERSION_NUMBERS@
PRODUCTVERSION @VERSION_NUMBERS@
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Voidcrew\0"
            VALUE "FileDescription", "Voidworks\0"
            VALUE "FileVersion", "@VERSION@\0"
            VALUE "InternalName", "Voidworks\0"
            VALUE "OriginalFilename", "Voidworks.exe\0"
            VALUE "ProductName", "Voidworks\0"
            VALUE "ProductVersion", "@VERSION@\0"
            VALUE "LegalCopyright", "SpaiR and StrongDMM contributors; Voidcrew fork contributors. GPL-3.0.\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
